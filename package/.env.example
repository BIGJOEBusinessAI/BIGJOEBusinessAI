# BIGJOE configuration
PORT=8000
HOST=0.0.0.0
APP_BASE_URL=http://127.0.0.1:8000

# Flutterwave TEST secret key. Never put this in public frontend code.
FLW_SECRET_KEY=FLWSECK_ Optional: enables real AI responses. Leave blank to use BIGJOE's built-in assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# BIGJOE subscription gateway. For the local owner build, if these are blank, BIGJOE
# can use the logged-in owner's Flutterwave account configured in Payment Hub.
# For production/multi-tenant deployment, use these dedicated platform credentials.
# These are used only for BIGJOE Free/Business/Pro subscription checkout.
FLW_SUBSCRIPTION_SECRET_KEY=
FLW_SUBSCRIPTION_MODE=test
FLW_SUBSCRIPTION_BUSINESS_PAYMENT_PLAN_ID=
FLW_SUBSCRIPTION_PRO_PAYMENT_PLAN_ID=

# Flutterwave webhook secret hash (set this in Flutterwave Dashboard → Settings → Webhooks)
FLW_WEBHOOK_SECRET_HASH=

# Backward-compatible aliases for older builds (optional).
FLW_BUSINESS_PAYMENT_PLAN_ID=
FLW_PRO_PAYMENT_PLAN_ID=

# For production, replace localhost with your real HTTPS BIGJOE domain.
